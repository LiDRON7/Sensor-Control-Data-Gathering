<?xml version="1.0"?>
<package format="3">
  <name>oak_d_ros2</name>
  <version>0.2.0</version>
  <description>Distance-only ROS bridge for the original OAK-D Python viewer.</description>
  <maintainer email="lidron@users.noreply.github.com">lidron</maintainer>
  <license>MIT</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>oak_d_interfaces</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
